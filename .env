# ========================================================
# PARASNATH AI - ENVIRONMENT CONFIGURATION
# Parasnath Speciality Clinic, Badlapur | Revonix Solution
# ========================================================

# --------------------------------------------------------
# 1. ACTIVE AI EXTRACTION ENGINE
# --------------------------------------------------------
# Options: "gemini" | "groq" | "openrouter" | "openai" | "mock"
# Recommended Free: "gemini" (Google AI Studio) or "groq" (Groq Cloud)
AI_PROVIDER=gemini

# Selected LLM Model Name
# Free Gemini: "gemini-3.5-flash" (Recommended), "gemini-3.5-flash-lite", "gemini-flash-latest"
# Free Groq: "openai/gpt-oss-120b", "openai/gpt-oss-20b", "llama-3.3-70b-versatile"
# Free OpenRouter: "meta-llama/llama-3.3-70b-instruct:free", "google/gemini-2.0-flash-exp:free"
# OpenAI (Paid): "gpt-4o", "gpt-4o-mini"
AI_MODEL=gemini-3.5-flash

# Active Speech-to-Text Transcription Provider
# Options: "groq" (Free Whisper) | "openai" | "deepgram" | "mock"
TRANSCRIPTION_PROVIDER=groq

# --------------------------------------------------------
# 2. PROVIDER API KEYS (Paste your free key below)
# --------------------------------------------------------
# Free Google Gemini Key -> Get at: https://aistudio.google.com/app/apikey (100% Free, 1500 req/day)
GEMINI_API_KEY=AQ.Ab8RN6LY1poZJOLk6JxhqMyCbqNQdcZeMXd8XhD1GoAVL2_kvA

# Free Groq Key -> Get at: https://console.groq.com/keys (100% Free, ultra-fast 300 t/s Llama-3.3)
GROQ_API_KEY=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

# Free OpenRouter Key -> Get at: https://openrouter.ai/keys (Free models with :free tag) 
OPENROUTER_API_KEY=

# Optional Paid Provider Keys
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# --------------------------------------------------------
# 3. CLINICAL AI SYSTEM PROMPTS (Editable in .env)
# --------------------------------------------------------
# Core Clinical Extraction Prompt: Enforces doctor-approval doctrine,
# prevents hallucinations, extracts 12-part clinical case papers & prescriptions.
CLINICAL_EXTRACTION_SYSTEM_PROMPT="You are PARASNATH AI, an expert medical transcription and documentation engine for Parasnath Speciality Clinic, Badlapur. Core Directive: You are a clinical documentation assistant, NEVER an autonomous doctor. 1. NEVER diagnose independently or invent any symptoms, clinical signs, medicines, or dosages. 2. Only extract information that was explicitly stated or confirmed in the consultation transcript. 3. Maintain strict separation between patient-reported symptoms and doctor-confirmed observations. 4. Keep suspected diagnoses completely separate from confirmed diagnoses. 5. If a medicine dosage, frequency, or duration is missing or ambiguous, leave it flagged in the 'flags' array; NEVER guess or fill it in. 6. Support multilingual consultation input (Hindi, Marathi, English, and code-switched Hinglish). Translate clinical terms accurately into standard medical English for the structured record while preserving patient nuances. Output strictly valid JSON matching the 12-part schema with patientSymptomsReported, durationAndSeverity, relevantMedicalHistory, doctorClinicalObservations, suspectedDiagnoses, confirmedDiagnoses, treatmentRecommendations, medicinesMentioned, lifestyleDietInstructions, followUpRecommendation, followUpDate, and flags."

# Medical Speech-to-Text Transcription Prompt:
# Guides Whisper/audio models on Indian medical terminology, OPD vernacular & drug formulations.
TRANSCRIPTION_SYSTEM_PROMPT="Parasnath Speciality Clinic Outpatient Consultation. Orthopaedic and general medicine terms: Osteoarthritis, Paracetamol, Thiocolchicoside, Calcium Citrate, Cholecalciferol, bilateral knee, crepitus, joint stiffness, flexion, extension, MMC registration, Badlapur Central OPD. Bilingual Marathi, Hindi, and Indian English."

# Patient Intake Voice Note Symptom Summarizer Prompt:
PATIENT_INTAKE_PROMPT="You are the Parasnath Clinic Patient Intake Assistant. Listen to the patient's voice complaint in Marathi, Hindi, or English. Transcribe the patient's words verbatim and extract a 1-sentence concise primary complaint for the attending doctor."

# Extraction Sampling Temperature (0.0 to 0.2 strictly for medical determinism)
AI_EXTRACTION_TEMPERATURE=0.1

# --------------------------------------------------------
# 4. CLINIC & SERVER DEFAULTS
# --------------------------------------------------------
CLINIC_NAME="Parasnath Speciality Clinic"
CLINIC_LOCATION="Badlapur"
DEFAULT_BRANCH="Badlapur Central"
DEFAULT_LANGUAGE="en"
PORT=3000
